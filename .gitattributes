# Normalise les fins de ligne : LF dans le dépôt, quel que soit l'OS
* text=auto eol=lf

# Le Makefile et les scripts shell doivent rester en LF (sinon "missing separator" ou erreurs bash sous Windows)
Makefile text eol=lf
*.sh      text eol=lf

# Code et configuration
*.py   text eol=lf diff=python
*.txt  text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Fichiers binaires (pas de conversion ni de diff texte)
*.png  binary
*.jpg  binary
*.pdf  binary
*.safetensors binary
*.bin  binary
*.h5   binary
